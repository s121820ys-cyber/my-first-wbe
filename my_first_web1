<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>恶搞图片</title>
<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #111;
    font-family: sans-serif;
  }
  .wrap {
    text-align: center;
  }
  img {
    width: min(80vw, 420px);
    border-radius: 16px;
    cursor: pointer;
    transition: 0.2s;
    user-select: none;
  }
  img.shake {
    animation: shake 0.4s 2;
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px) rotate(-2deg); }
    75% { transform: translateX(8px) rotate(2deg); }
  }
  .tip {
    color: #aaa;
    margin-top: 12px;
    font-size: 16px;
  }
</style>
</head>
<body>
<div class="wrap">
  <img id="prank" src="cover.jpg" data-real="real.jpg" alt="点我">
  <div class="tip">点一下看看？</div>
</div>

<script>
  const img = document.getElementById('prank');
  const tip = document.querySelector('.tip');
  let clicked = false;

  img.addEventListener('click', () => {
    if (clicked) return;
    clicked = true;

    tip.textContent = '加载中... 99%';
    img.style.filter = 'blur(2px)';

    setTimeout(() => {
      img.src = img.dataset.real;   // 换成真图
      img.style.filter = 'none';
      img.classList.add('shake');
      tip.textContent = '哈哈，上当了！';

      // 可选：短促搞笑音效，别用恐怖爆音
      // new Audio('boing.mp3').play();
    }, 1000);
  });
</script>
</body>
</html>
