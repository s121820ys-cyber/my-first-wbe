<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>致我最爱的老婆 · 生日快乐</title>
<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; min-height: 100%; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
  body { min-height: 100vh; background: radial-gradient(circle at 20% 20%, #ff9a9e 0%, #fad0c4 30%, #fbc2eb 65%, #a18cd1 100%); overflow-x: hidden; color: #fff; }
  .floating-hearts { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
  .heart { position: absolute; bottom: -50px; animation: floatUp linear infinite; }
  @keyframes floatUp { to { transform: translateY(-120vh) rotate(360deg); opacity: 0; } }
  .card { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; padding: 40px 20px; min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; }
  .glass { width: 100%; background: rgba(255,255,255,.16); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,.35); border-radius: 28px; padding: 34px 22px; box-shadow: 0 20px 60px rgba(0,0,0,.18); }
  h1 { font-size: clamp(28px, 8vw, 48px); margin: 0 0 8px; letter-spacing: 2px; text-shadow: 0 4px 20px rgba(214,51,108,.35); }
  .date { font-size: 16px; opacity: .92; margin-bottom: 22px; }
  .slideshow { position: relative; width: 100%; height: 320px; border-radius: 20px; overflow: hidden; margin-bottom: 24px; border: 3px solid rgba(255,255,255,.75); box-shadow: 0 8px 20px rgba(0,0,0,.15); }
  .slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.5s ease-in-out; }
  .slide.active { opacity: 1; }
  .btn { margin-top: 26px; border: none; border-radius: 999px; padding: 16px 34px; font-size: 18px; font-weight: 700; color: #d6336c; background: linear-gradient(135deg, #fff, #ffe3ee); box-shadow: 0 10px 30px rgba(214,51,108,.35); cursor: pointer; animation: pulse 1.6s infinite; }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.06); } }
  .music-tip { margin-top: 18px; font-size: 14px; opacity: .88; line-height: 1.6; }
  .message p { font-size: clamp(16px, 4.2vw, 20px); line-height: 1.9; margin: 12px 0; opacity: 0; transform: translateY(16px); }
  .message.show p { animation: fadeUp .9s forwards; }
  .message.show p:nth-child(1) { animation-delay: .1s; } .message.show p:nth-child(2) { animation-delay: .3s; }
  .message.show p:nth-child(3) { animation-delay: .5s; } .message.show p:nth-child(4) { animation-delay: .7s; }
  .message.show p:nth-child(5) { animation-delay: .9s; } .message.show p:nth-child(6) { animation-delay: 1.1s; }
  .message.show p:nth-child(7) { animation-delay: 1.3s; } .message.show p:nth-child(8) { animation-delay: 1.5s; }
  .message.show p:nth-child(9) { animation-delay: 1.7s; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  .signature { margin-top: 26px; font-size: 18px; line-height: 1.8; font-weight: 700; }
  .boom { position: fixed; pointer-events: none; font-size: 28px; z-index: 99; animation: boom 1.2s ease-out forwards; }
  @keyframes boom { to { transform: translate(var(--x), var(--y)) rotate(var(--r)); opacity: 0; } }
</style>
</head>
<body>

<div class="floating-hearts" id="hearts"></div>

<div class="card">
  <div class="glass">
    <h1>致我最爱的老婆</h1>
    <div class="date">生日快乐 · 今天为你而浪漫</div>

    <!-- 这里的 1.jpg 到 17.jpg 就是你照片的名字，顺序不会乱 -->
    <div class="slideshow">
      <img src="1.jpg" class="slide active" alt="memory">
      <img src="2.jpg" class="slide" alt="memory">
      <img src="3.jpg" class="slide" alt="memory">
      <img src="4.jpg" class="slide" alt="memory">
      <img src="5.jpg" class="slide" alt="memory">
      <img src="6.jpg" class="slide" alt="memory">
      <img src="7.jpg" class="slide" alt="memory">
      <img src="8.jpg" class="slide" alt="memory">
      <img src="9.jpg" class="slide" alt="memory">
      <img src="10.jpg" class="slide" alt="memory">
      <img src="11.jpg" class="slide" alt="memory">
      <img src="12.jpg" class="slide" alt="memory">
      <img src="13.jpg" class="slide" alt="memory">
      <img src="14.jpg" class="slide" alt="memory">
      <img src="15.jpg" class="slide" alt="memory">
      <img src="16.jpg" class="slide" alt="memory">
      <img src="17.jpg" class="slide" alt="memory">
    </div>

    <button class="btn" id="startBtn">💗 轻触这里，开启生日惊喜</button>
    <div class="music-tip" id="musicTip">点击后，浪漫的旋律会陪着你一起出现</div>

    <div class="message" id="loveContent">
      <p>亲爱的老婆：</p>
      <p>从遇见你的那天起，我的世界就有了温柔的方向。</p>
      <p>你笑的时候，像春日花海开满整个夏天；</p>
      <p>你皱眉的时候，我想把全世界的糖都给你。</p>
      <p>谢谢你陪我走过平凡的日子，把柴米油盐过成浪漫的诗。</p>
      <p>今天是你生日，我想认真地对你说：</p>
      <p>不止今天，而是余生每一天，我都爱你。</p>
      <p>愿你所愿皆成，愿你眼里有光，心中有暖，身边有我。</p>
      <p class="signature">——永远爱你的老公</p>
    </div>
  </div>
</div>

<!-- 内置了一首免版税的韩国风浪漫钢琴曲，直接可用 -->
<audio id="bgm" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_20623eb3a6.mp3?filename=romantic-piano-113953.mp3" loop preload="auto"></audio>

<script>
  const hearts = document.getElementById('hearts');
  const heartChars = ['❤', '💗', '💕', '💖', '🌸'];
  for (let i = 0; i < 26; i++) {
    const el = document.createElement('div');
    el.className = 'heart';
    el.textContent = heartChars[Math.floor(Math.random() * heartChars.length)];
    el.style.left = Math.random() * 100 + 'vw';
    el.style.fontSize = (14 + Math.random() * 26) + 'px';
    el.style.animationDuration = (8 + Math.random() * 10) + 's';
    el.style.animationDelay = (-Math.random() * 12) + 's';
    el.style.opacity = 0.4 + Math.random() * 0.5;
    hearts.appendChild(el);
  }

  // 自动播放照片的逻辑
  const slides = document.querySelectorAll('.slide');
  let currentSlide = 0;
  if (slides.length > 0) {
    setInterval(() => {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }, 3500); // 每3.5秒自动换一张
  }

  const btn = document.getElementById('startBtn');
  const bgm = document.getElementById('bgm');
  const content = document.getElementById('loveContent');
  const tip = document.getElementById('musicTip');

  function boomHearts() {
    for (let i = 0; i < 18; i++) {
      const s = document.createElement('div');
      s.className = 'boom';
      s.textContent = ['❤', '💗', '💖', '✨', '🌸'][Math.floor(Math.random() * 5)];
      s.style.left = (window.innerWidth / 2) + 'px';
      s.style.top = (window.innerHeight / 2) + 'px';
      s.style.setProperty('--x', (Math.random() * 400 - 200) + 'px');
      s.style.setProperty('--y', (Math.random() * 400 - 200) + 'px');
      s.style.setProperty('--r', (Math.random() * 360) + 'deg');
      document.body.appendChild(s);
      setTimeout(() => s.remove(), 1300);
    }
  }

  btn.addEventListener('click', async () => {
    btn.style.display = 'none';
    tip.textContent = '音乐响起，浪漫正在发生……';
    content.classList.add('show');
    boomHearts();

    try {
      bgm.volume = 0;
      await bgm.play();
      let v = 0;
      const fade = setInterval(() => {
        v += 0.04;
        if (v >= 0.85) { bgm.volume = 0.85; clearInterval(fade); } else { bgm.volume = v; }
      }, 200);
    } catch (err) {
      tip.textContent = '音乐播放失败，请点右上角在浏览器中打开。';
    }
  });
</script>
</body>
</html>
