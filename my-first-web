<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>恶搞炸弹</title>
<style>
  :root{
    --bg:#050505;
    --red:#ff2b2b;
    --yellow:#ffcc00;
    --green:#39ff14;
    --text:#fff;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{
    margin:0;height:100%;background:var(--bg);color:var(--text);
    font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
    overflow:hidden;
  }
  body.fake-lock{position:fixed;inset:0;}

  .screen{
    position:fixed;inset:0;
    display:flex;flex-direction:column;
    align-items:center;justify-content:center;
    padding:24px;text-align:center;
    background:radial-gradient(circle at 50% 30%,#2a0000,#050505 70%);
  }

  .bomb{
    font-size:96px;line-height:1;
    filter:drop-shadow(0 0 18px #ff2b2b);
    animation:pulse .6s infinite alternate;
  }
  @keyframes pulse{
    from{transform:scale(.92)}
    to{transform:scale(1.08)}
  }

  .warning{
    font-size:20px;font-weight:800;color:var(--red);
    margin:18px 0 6px;text-shadow:0 0 14px #ff0000;
  }
  .tip{font-size:14px;color:#bbb;margin-bottom:18px;}

  .count{
    font-size:88px;font-weight:900;color:var(--yellow);
    text-shadow:0 0 24px #ff6600;margin:10px 0;
  }

  .bar{
    width:min(420px,90vw);height:14px;
    border:1px solid var(--red);border-radius:999px;
    overflow:hidden;margin:12px 0 18px;
  }
  #progress{
    height:100%;width:0%;
    background:linear-gradient(90deg,var(--red),var(--yellow));
    transition:width .2s;
  }

  .buttons{
    display:flex;gap:10px;flex-wrap:wrap;
    justify-content:center;margin-top:8px;
  }
  button{
    border:0;border-radius:999px;padding:12px 20px;
    font-size:16px;font-weight:800;cursor:pointer;
  }
  #exitBtn{background:#39ff14;color:#000;}
  #fsBtn{background:#222;color:#fff;border:1px solid #555;}
  #againBtn{background:#ffcc00;color:#000;display:none;}

  .shake{animation:shake .45s infinite;}
  @keyframes shake{
    0%{transform:translate(1px,1px) rotate(0)}
    25%{transform:translate(-2px,0) rotate(-1deg)}
    50%{transform:translate(2px,-1px) rotate(1deg)}
    75%{transform:translate(-1px,2px) rotate(0)}
    100%{transform:translate(1px,-2px) rotate(-1deg)}
  }

  .flash{animation:flash .3s infinite;}
  @keyframes flash{
    0%,100%{background:#050505}
    50%{background:#3a0000}
  }

  .safe{font-size:16px;line-height:1.7;color:#39ff14;}
  .small{
    font-size:12px;color:#777;margin-top:20px;
    max-width:420px;
  }
</style>
</head>
<body>
<div class="screen" id="screen">
  <div class="bomb" id="bomb">💣</div>
  <div class="warning" id="warningText">警告：恶搞炸弹已激活</div>
  <div class="tip" id="tipText">纯属恶搞，可随时退出</div>
  <div class="count" id="count">3</div>
  <div class="bar"><div id="progress"></div></div>

  <div class="buttons">
    <button id="exitBtn">退出恶搞</button>
    <button id="fsBtn">全屏效果</button>
    <button id="againBtn">再来一次</button>
  </div>

  <div class="small">
    这不是真锁屏。返回键、关闭页面、ESC 都可以正常使用。
    不要吓长辈或心脏病人。
  </div>
</div>

<script>
  // ============ 主要数据都在这里改 ============
  const CONFIG = {
    warningText: "警告：恶搞炸弹已激活",
    tipText: "纯属恶搞，可随时退出",

    countdownFrom: 3,          // 倒计时秒数
    countdownInterval: 1000,   // 每 1000 毫秒跳一次

    finalTitle: "💥 BOOM！",
    finalText: "哈哈，骗你的，只是恶搞 😄",

    exitText: "退出恶搞",
    safeTitle: "✅ 已退出",
    safeText: "别怕，刚才只是网页动画，没有病毒，也没有锁屏。",

    alarm: true,               // 最后是否闪红、抖动
    vibrate: false,            // 是否尝试震动，部分浏览器无效
    fakeFullscreen: true       // 伪全屏：铺满屏幕，但不锁返回
  };
  // ==========================================

  const screen = document.getElementById('screen');
  const bomb = document.getElementById('bomb');
  const warningText = document.getElementById('warningText');
  const tipText = document.getElementById('tipText');
  const countEl = document.getElementById('count');
  const progress = document.getElementById('progress');
  const exitBtn = document.getElementById('exitBtn');
  const fsBtn = document.getElementById('fsBtn');
  const againBtn = document.getElementById('againBtn');

  let timer = null;
  let n = CONFIG.countdownFrom;

  function start() {
    clearInterval(timer);
    n = CONFIG.countdownFrom;

    countEl.style.display = 'block';
    countEl.textContent = n;
    warningText.textContent = CONFIG.warningText;
    tipText.textContent = CONFIG.tipText;
    bomb.textContent = '💣';
    progress.style.width = '0%';
    againBtn.style.display = 'none';

    screen.classList.remove('shake', 'flash');
    if (CONFIG.fakeFullscreen) document.body.classList.add('fake-lock');

    timer = setInterval(() => {
      n--;
      progress.style.width =
        ((CONFIG.countdownFrom - n) / CONFIG.countdownFrom * 100) + '%';

      if (n > 0) {
        countEl.textContent = n;
      } else {
        clearInterval(timer);

        countEl.style.display = 'none';
        bomb.textContent = '💥';
        warningText.textContent = CONFIG.finalTitle;
        tipText.textContent = CONFIG.finalText;
        progress.style.width = '100%';

        if (CONFIG.alarm) screen.classList.add('shake', 'flash');

        if (CONFIG.vibrate && navigator.vibrate) {
          navigator.vibrate([200, 100, 200]);
        }

        againBtn.style.display = 'inline-block';
      }
    }, CONFIG.countdownInterval);
  }

  exitBtn.onclick = () => {
    clearInterval(timer);
    screen.classList.remove('shake', 'flash');
    document.body.classList.remove('fake-lock');

    screen.style.position = 'relative';
    screen.style.inset = 'auto';
    screen.style.minHeight = '100vh';

    screen.innerHTML = `
      <div class="bomb">✅</div>
      <div class="warning" style="color:#39ff14">${CONFIG.safeTitle}</div>
      <div class="safe">${CONFIG.safeText}</div>
      <div class="buttons">
        <button id="closeTip" style="background:#39ff14;color:#000">
          知道了
        </button>
      </div>
    `;

    document.getElementById('closeTip').onclick = () => {
      document.getElementById('closeTip').textContent = '直接关掉页面就行';
    };
  };

  // 用户点击才能进入全屏，ESC 可退出，不能锁死
  fsBtn.onclick = async () => {
    try {
      if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
        await document.documentElement.requestFullscreen();
      } else if (document.exitFullscreen) {
        await document.exitFullscreen();
      }
    } catch (e) {
      alert('浏览器不允许自动全屏，请手动操作');
    }
  };

  againBtn.onclick = start;
  start();
</script>
</body>
</html>
